// Zelamar delivery service. Configuration reference:
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zelamar-server",
  "main": "src/index.ts",
  // Newest date supported by the pinned workerd runtime; advance it deliberately.
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "INVITES", "class_name": "Invites" },
      { "name": "GROUP", "class_name": "Group" },
      { "name": "LINK", "class_name": "Link" },
      { "name": "BLOB", "class_name": "Blob" },
      { "name": "PUSH", "class_name": "Push" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Account", "Mailbox", "Invites"] },
    { "tag": "v2", "new_sqlite_classes": ["Group"] },
    { "tag": "v3", "new_sqlite_classes": ["Link"] },
    { "tag": "v4", "new_sqlite_classes": ["Blob"] },
    { "tag": "v5", "new_sqlite_classes": ["Push"] },
  ],
  // Proof-of-work difficulty for claiming a username (protocol/directory.md).
  // INVITE_KEY (hex, 32+ bytes) is a secret: `wrangler secret put INVITE_KEY`.
  // FCM_SERVICE_ACCOUNT (a Firebase service account key, JSON) is a secret
  // too; without it push wake-ups are only counted (ADR-0017).
  // TURN_KEY_ID and TURN_KEY_API_TOKEN (a Cloudflare TURN key) are secrets
  // too; without them calls get STUN only and connect directly (ADR-0019).
  "vars": { "WORK_BITS": "21" },
  // Per network address, until anonymous tokens take over (ADR-0012).
  "ratelimits": [
    { "name": "DELIVER_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "CLAIM_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    // Both devices poll their link slot every few seconds, maybe from one address.
    { "name": "LINK_LIMITER", "namespace_id": "1004", "simple": { "limit": 90, "period": 60 } },
    // File chunks of 1 MiB: a 25 MiB file is 25 requests.
    { "name": "UPLOAD_LIMITER", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    {
      "name": "DOWNLOAD_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 600, "period": 60 },
    },
    // Fetching a recovery kit: a person types a key a few times at most.
    { "name": "RECOVER_LIMITER", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } },
    // Call servers: one list per call, a few calls a minute at most.
    { "name": "ICE_LIMITER", "namespace_id": "1008", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
