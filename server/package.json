{
  "name": "zelamar-server",
  "version": "0.1.0",
  "description": "Zelamar delivery service on Cloudflare Workers. Delivers everything, knows nothing.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run typecheck && npm run lint && node scripts/invites.mjs --self-test && npm run test",
    "invites": "node scripts/invites.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "~5.0.5",
    "wrangler": "^4.150.0"
  }
}
